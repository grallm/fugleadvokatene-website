---
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { t } from '../i18n/ui';
import { href, type Language } from '../i18n/routes';
interface Props { person: CollectionEntry<'volunteers' | 'volunteersEn'>; language?: Language }
const { person, language = 'nb' } = Astro.props;
const text = t(language);
const { Content } = await render(person);
---
<Layout title={person.data.title} description={person.data.description} noindex={person.data.draft} language={language}><article class="container page"><p><a href={href(language, 'volunteer')}>{text.meetVolunteers}</a></p><h1>{person.data.title}</h1><div class="two-columns"><img src={person.data.image} alt={person.data.title} /><div class="prose"><p>{person.data.role}{person.data.city && ` · ${person.data.city}`}</p>{person.data.draft && <p class="notice">{text.volunteerDraft}</p>}<Content /></div></div></article></Layout>
