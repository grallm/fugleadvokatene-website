---
import Layout from "../layouts/Layout.astro";
import Placeholder from "./Placeholder.astro";
import LangSwitcher from "./LangSwitcher.astro";
import { Image } from "astro:assets";
import logo from "../assets/logo-notext.webp";
import { useTranslations, type Lang } from "../i18n/ui";

const lang = (Astro.currentLocale ?? "no") as Lang;
const t = useTranslations(lang);

const navLinks = [
  t("nav.contact"),
  t("nav.store"),
  t("nav.blog"),
  t("nav.guides"),
  t("nav.about"),
];

const welcomeCards = [
  { title: t("welcome.card1.title"), body: t("welcome.card1.body") },
  { title: t("welcome.card2.title"), body: t("welcome.card2.body") },
];

const guides = [
  { title: t("guide.injured.title"), body: t("guide.injured.body") },
  { title: t("guide.handling.title"), body: t("guide.handling.body") },
  { title: t("guide.hygiene.title"), body: t("guide.hygiene.body") },
  { title: t("guide.species.title"), body: t("guide.species.body") },
];

const blogPosts = [
  { title: t("blog.post1.title"), caption: t("blog.post1.caption") },
  { title: t("blog.post2.title"), caption: t("blog.post2.caption") },
];

const products = [
  {
    name: t("product.pin.name"),
    price: t("product.price"),
    description: t("product.description"),
  },
  {
    name: t("product.card.name"),
    price: t("product.price"),
    description: t("product.description"),
  },
  {
    name: t("product.bag.name"),
    price: t("product.price"),
    description: t("product.description"),
  },
];

const homeHref =
  lang === "no"
    ? import.meta.env.BASE_URL
    : `${import.meta.env.BASE_URL}/en/`.replace(/\/+/g, "/");

const container = "max-w-[1100px] mx-auto px-6";
const cardBase = "block border border-line p-4.5 bg-white text-ink";
---

<Layout>
  <header class="pt-6">
    <div
      class={`${container} flex items-start justify-between gap-6 max-[760px]:flex-col`}
    >
      <a href={homeHref} class="flex items-center gap-3">
        <Image src={logo} alt="FugleAdvokatene logo" width="100" />
        <span class="text-3xl font-bold">FugleAdvokatene</span>
      </a>
      <div class="flex w-60 flex-col items-end gap-2 max-[760px]:w-full">
        <LangSwitcher />
        <Placeholder height="90px" width="100%" />
      </div>
    </div>
    <nav class="border-line mt-4.5 border-b">
      <div
        class={`${container} flex justify-center gap-20 py-3.5 flex-wrap max-[760px]:gap-6`}
      >
        {
          navLinks.map((label) => (
            <a href="#" class="text-sm">
              {label}
            </a>
          ))
        }
      </div>
    </nav>
  </header>

  <main class="pb-15">
    <section
      class={`${container} mt-8 grid grid-cols-2 gap-8 items-start max-[760px]:grid-cols-1`}
    >
      <div>
        <h2 class="mb-2 text-lg leading-tight font-bold">
          {t("welcome.title")}
        </h2>
        <p class="text-sm">{t("welcome.body")}</p>
      </div>
      <div class="grid grid-cols-2 gap-4 max-[760px]:grid-cols-1">
        {
          welcomeCards.map((card) => (
            <a class={`${cardBase} px-4 py-3.5`} href="#">
              <h3 class="mb-2.5 text-sm font-bold">{card.title}</h3>
              <p class="text-muted text-xs">{card.body}</p>
            </a>
          ))
        }
      </div>
    </section>

    <section class={`${container} mt-14`}>
      <h2 class="mb-1 text-lg font-bold">{t("found.title")}</h2>
      <p class="mb-5 text-sm">{t("found.body")}</p>
      <div class="grid grid-cols-2 gap-4.5 max-[760px]:grid-cols-1">
        {
          guides.map((g) => (
            <a class={cardBase} href="#">
              <h3 class="mb-2.5 text-sm font-bold">{g.title}</h3>
              <p class="text-muted text-xs">{g.body}</p>
            </a>
          ))
        }
      </div>
    </section>

    <section class={`${container} mt-14`}>
      <h2 class="mb-1 text-lg font-bold">{t("blog.title")}</h2>
      <div class="grid grid-cols-2 gap-10 max-[760px]:grid-cols-1">
        {
          blogPosts.map((post) => (
            <article>
              <h3 class="mb-3.5 text-[15px] font-bold">{post.title}</h3>
              <Placeholder height="200px" />
              <p class="text-muted mt-2.5 text-xs">{post.caption}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class={`${container} mt-14`}>
      <h2 class="mb-1 text-center text-lg font-bold">{t("regulars.title")}</h2>
      <div class="grid grid-cols-2 items-start gap-10 max-[760px]:grid-cols-1">
        <div class="grid gap-4">
          <Placeholder height="180px" />
          <Placeholder height="180px" />
          <p class="text-muted mt-2.5 text-xs">{t("regulars.caption")}</p>
        </div>
        <div class={cardBase}>
          <h3 class="mb-3.5 text-[15px] font-bold">
            {t("regulars.areas.title")}
          </h3>
          <Placeholder height="180px" />
          <p class="text-muted mt-2.5 text-xs">
            {t("regulars.areas.caption")}
          </p>
        </div>
      </div>
    </section>

    <section class={`${container} mt-14`}>
      <h2 class="mb-1 text-center text-lg font-bold">{t("store.title")}</h2>
      <h3 class="mt-4.5 mb-3.5 text-sm font-bold">{t("store.popular")}</h3>
      <div class="grid grid-cols-3 gap-6 max-[760px]:grid-cols-1">
        {
          products.map((product) => (
            <article>
              <Placeholder height="180px" />
              <h4 class="mt-3 mb-1 text-[13px] font-bold">{product.name}</h4>
              <p class="mb-0.5 text-[13px]">{product.price}</p>
              <p class="text-[13px]">{product.description}</p>
            </article>
          ))
        }
      </div>
    </section>
  </main>

  <footer class="bg-surface-alt py-7">
    <div
      class={`${container} grid grid-cols-2 gap-6 items-center max-[760px]:grid-cols-1`}
    >
      <div>
        <p class="mb-2 text-[13px] font-bold">FugleAdvokatene</p>
        <p class="mb-1 text-[13px]">
          <span class="text-muted inline-block min-w-9">{t("footer.mail")}</span
          >
          kontakt@fugleadvokatene.no
        </p>
        <p class="mb-1 text-[13px]">
          <span class="text-muted inline-block min-w-9"
            >{t("footer.phone")}</span
          >
          99 99 99 99
        </p>
      </div>
      <div class="text-center max-[760px]:text-left">
        <p class="mb-3 text-[13px]">{t("footer.social")}</p>
        <div
          class="text-ink flex justify-center gap-4.5 max-[760px]:justify-start"
          aria-label={t("footer.social")}
        >
          <a
            href="#"
            aria-label="Facebook"
            class="inline-flex items-center justify-center"
          >
            <svg viewBox="0 0 24 24" width="22" height="22">
              <path
                fill="currentColor"
                d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.2c-1.2 0-1.6.8-1.6 1.6V12h2.7l-.4 2.9h-2.3v7A10 10 0 0 0 22 12z"
              ></path>
            </svg>
          </a>
          <a
            href="#"
            aria-label="Instagram"
            class="inline-flex items-center justify-center"
          >
            <svg viewBox="0 0 24 24" width="22" height="22">
              <path
                fill="currentColor"
                d="M12 2.2c3.2 0 3.6 0 4.8.1 1.2 0 1.9.2 2.3.4.6.2 1 .5 1.5 1s.7.9 1 1.5c.2.4.3 1.1.4 2.3.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c0 1.2-.2 1.9-.4 2.3-.2.6-.5 1-1 1.5s-.9.7-1.5 1c-.4.2-1.1.3-2.3.4-1.3.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2 0-1.9-.2-2.3-.4-.6-.2-1-.5-1.5-1s-.7-.9-1-1.5c-.2-.4-.3-1.1-.4-2.3-.1-1.3-.1-1.6-.1-4.8s0-3.6.1-4.8c0-1.2.2-1.9.4-2.3.2-.6.5-1 1-1.5s.9-.7 1.5-1c.4-.2 1.1-.3 2.3-.4 1.3-.1 1.6-.1 4.8-.1zm0 2c-3.1 0-3.5 0-4.7.1-1.1 0-1.7.2-2 .4-.5.2-.9.4-1.3.8-.4.4-.6.8-.8 1.3-.2.3-.4.9-.4 2-.1 1.2-.1 1.6-.1 4.7s0 3.5.1 4.7c0 1.1.2 1.7.4 2 .2.5.4.9.8 1.3.4.4.8.6 1.3.8.3.2.9.4 2 .4 1.2.1 1.6.1 4.7.1s3.5 0 4.7-.1c1.1 0 1.7-.2 2-.4.5-.2.9-.4 1.3-.8.4-.4.6-.8.8-1.3.2-.3.4-.9.4-2 .1-1.2.1-1.6.1-4.7s0-3.5-.1-4.7c0-1.1-.2-1.7-.4-2-.2-.5-.4-.9-.8-1.3-.4-.4-.8-.6-1.3-.8-.3-.2-.9-.4-2-.4-1.2-.1-1.6-.1-4.7-.1zm0 3.4a4.4 4.4 0 1 1 0 8.8 4.4 4.4 0 0 1 0-8.8zm0 7.3a2.9 2.9 0 1 0 0-5.8 2.9 2.9 0 0 0 0 5.8zm5.6-7.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0z"
              ></path>
            </svg>
          </a>
          <a
            href="#"
            aria-label="Twitter"
            class="inline-flex items-center justify-center"
          >
            <svg viewBox="0 0 24 24" width="22" height="22">
              <path
                fill="currentColor"
                d="M22 5.8c-.7.3-1.5.5-2.4.6.9-.5 1.5-1.4 1.8-2.4-.8.5-1.7.8-2.6 1A4.1 4.1 0 0 0 11.7 9c-3.4-.2-6.4-1.8-8.4-4.3-.4.6-.6 1.4-.6 2.2 0 1.4.7 2.7 1.8 3.4-.7 0-1.3-.2-1.9-.5 0 2 1.4 3.7 3.3 4.1-.4.1-.7.2-1.1.2-.3 0-.5 0-.8-.1.5 1.7 2.1 2.9 3.9 2.9A8.3 8.3 0 0 1 2 18.6 11.7 11.7 0 0 0 8.3 20c7.5 0 11.6-6.2 11.6-11.6v-.5c.8-.6 1.5-1.3 2.1-2.1z"
              ></path>
            </svg>
          </a>
          <a
            href="#"
            aria-label="TikTok"
            class="inline-flex items-center justify-center"
          >
            <svg viewBox="0 0 24 24" width="22" height="22">
              <path
                fill="currentColor"
                d="M19.6 6.7a4.7 4.7 0 0 1-3-1.7 4.6 4.6 0 0 1-1-2.5h-3v12.4c0 1.4-1.2 2.6-2.6 2.6a2.6 2.6 0 1 1 .8-5.1V9.3a5.7 5.7 0 1 0 4.8 5.6V9.5a7.7 7.7 0 0 0 4 1.3V7.7c-.1 0-.7-.1-1-1z"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </footer>
</Layout>
