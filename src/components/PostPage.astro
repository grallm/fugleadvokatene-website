---
import Photo from './Photo.astro';
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { t } from '../i18n/ui';
import { href, locale, type Language } from '../i18n/routes';
interface Props { post: CollectionEntry<'posts' | 'postsEn'>; language?: Language }
const { post, language = 'nb' } = Astro.props;
const text = t(language);
const { Content } = await render(post);
---
<Layout title={post.data.title} description={post.data.description} image={post.data.image} noindex={post.data.draft} language={language}><article class="container page"><p><a href={href(language, 'news')}>← {text.news}</a></p><h1>{post.data.title}</h1><p>{post.data.date.toLocaleDateString(locale[language])}</p>{post.data.draft && <p class="notice">{text.postDraft}</p>}<div class="prose"><Photo src={post.data.image} alt="" /><Content /></div></article></Layout>
