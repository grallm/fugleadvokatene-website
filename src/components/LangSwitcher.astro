---
import type { Lang } from "../i18n/ui";

const lang = (Astro.currentLocale ?? "no") as Lang;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const links: { code: Lang; label: string; href: string }[] = [
  { code: "no", label: "NO", href: `${base}/` },
  { code: "en", label: "EN", href: `${base}/en/` },
];
---

<div
  class="flex items-center gap-2 text-xs"
  aria-label="Language"
  data-lang-switcher
>
  {
    links.map((l, i) => (
      <>
        {i > 0 && <span class="text-muted">|</span>}
        <a
          href={l.href}
          hreflang={l.code}
          data-lang={l.code}
          aria-current={l.code === lang ? "true" : undefined}
          class:list={[
            "uppercase",
            l.code === lang ? "font-bold" : "text-muted hover:text-ink",
          ]}
        >
          {l.label}
        </a>
      </>
    ))
  }
</div>

<script is:inline>
  (function () {
    try {
      document
        .querySelectorAll("[data-lang-switcher] a[data-lang]")
        .forEach(function (a) {
          a.addEventListener("click", function () {
            try {
              localStorage.setItem("lang", a.getAttribute("data-lang"));
            } catch (e) {}
          });
        });
    } catch (e) {}
  })();
</script>
