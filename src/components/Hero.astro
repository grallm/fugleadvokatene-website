---
import { site } from '../data/site';
import { t } from '../i18n/ui';
import { href, type Language } from '../i18n/routes';
interface Props { language?: Language }
const { language = 'nb' } = Astro.props;
const text = t(language);
const slides = [
  { title: text.injuredBird, image: 'e8f31.svg', alt: text.birdAlt, href: site.helpGroup, label: text.clickHere, steps: text.heroSteps },
  { title: text.heroSupportTitle, image: '7bcf9.svg', alt: text.pigeonAlt, href: href(language, 'support'), label: text.support, text: text.heroSupportText },
  { title: text.volunteerQuestion, image: '2ae5f.svg', alt: text.volunteerAlt, href: href(language, 'volunteer'), label: text.readMore, text: text.heroVolunteerText },
];
---
<section class="hero" aria-label={text.heroLabel} aria-roledescription={text.carousel}>
  <div class="slides">{slides.map((slide, index) => <div class="slide" hidden={index !== 0} role="group" aria-roledescription={text.slide} aria-label={`${index + 1} ${text.of} 3`}>
    <img class="hero-photo" src={`/images/demo/${slide.image}`} alt={slide.alt} fetchpriority={index === 0 ? 'high' : 'auto'} />
    <div class="hero-copy"><h2>{slide.title}</h2>{slide.steps ? <ol>{slide.steps.map(step => <li>{step}</li>)}</ol> : <p>{slide.text}</p>}<a class="button" href={slide.href}>{slide.label}</a></div>
  </div>)}</div>
  <div class="carousel-controls"><button data-direction="-1" aria-label={text.previousSlide}>‹</button>{slides.map((slide, index) => <button class="dot" data-slide={index} aria-label={slide.title} aria-pressed={index === 0}></button>)}<button data-direction="1" aria-label={text.nextSlide}>›</button></div>
</section>

<style>.hero{position:relative}.slide:not([hidden]){display:grid;grid-template-columns:1fr 1fr;min-height:462px}.hero-photo{width:100%;height:100%;max-height:500px;object-fit:cover}.hero-copy{background:var(--teal);padding:64px 8.9% 40px;color:#fff;display:flex;align-items:flex-start;flex-direction:column}.hero-copy h2{font-size:clamp(32px,3.7vw,64px);color:white;margin-bottom:28px;white-space:normal}.hero-copy ol{padding-left:30px;margin:0 0 25px}.hero-copy li,.hero-copy p{line-height:2.08;font-size:clamp(16px,1.39vw,24px)}.hero-copy .button{align-self:flex-end;margin-top:auto}.carousel-controls{position:absolute;left:25%;transform:translateX(-50%);bottom:35px;display:flex;align-items:center;gap:12px}.carousel-controls button{border:0;background:none;color:white;font-size:48px;line-height:1;padding:0 5px;min-width:30px;min-height:44px}.carousel-controls .dot{min-width:0;min-height:0;width:20px;height:20px;border:2px solid white;border-radius:50%;padding:0}.dot[aria-pressed=true]{background:white}@media(max-width:1000px){.slide:not([hidden]){grid-template-columns:1fr}.hero-photo{height:auto;aspect-ratio:393/210;max-height:420px}.hero-copy{padding:34px 37px;min-height:260px}.hero-copy h2{font-size:32px;white-space:normal;margin-bottom:18px}.hero-copy li,.hero-copy p{font-size:16px;line-height:29px}.hero-copy ol{padding-left:24px;margin-bottom:15px}.carousel-controls{top:min(calc(100vw * .534 - 54px),366px);bottom:auto;left:50%;gap:8px}.carousel-controls .dot{width:13px;height:13px}.carousel-controls button{font-size:36px;min-width:24px}}</style>
<script>const hero=document.querySelector('.hero');const slides=Array.from(hero?.querySelectorAll<HTMLElement>('.slide')??[]);const dots=Array.from(hero?.querySelectorAll<HTMLButtonElement>('[data-slide]')??[]);let active=0;function show(i:number){active=(i+slides.length)%slides.length;slides.forEach((s,n)=>s.hidden=n!==active);dots.forEach((d,n)=>d.setAttribute('aria-pressed',String(n===active)));}dots.forEach((d,i)=>d.addEventListener('click',()=>show(i)));hero?.querySelectorAll<HTMLElement>('[data-direction]').forEach(b=>b.addEventListener('click',()=>show(active+Number(b.dataset.direction))));</script>
