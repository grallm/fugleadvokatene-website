---
import Photo from './Photo.astro';
import { site } from '../data/site';
import { t } from '../i18n/ui';
import { href, type Language } from '../i18n/routes';
interface Props { language?: Language }
const { language = 'nb' } = Astro.props;
const text = t(language);
const slides = [
  { title: text.injuredBird, image: 'pigeon-closeup.webp', alt: text.pigeonAlt, href: site.helpGroup, label: text.clickHere, steps: text.heroSteps },
  { title: text.heroSupportTitle, image: 'baby-bird.webp', alt: text.birdAlt, href: href(language, 'support'), label: text.support, text: text.heroSupportText },
  { title: text.volunteerQuestion, image: 'volunteer-pigeon.webp', alt: text.volunteerAlt, href: href(language, 'volunteer'), label: text.readMore, text: text.heroVolunteerText },
];
---
<section class="hero" aria-label={text.heroLabel} aria-roledescription={text.carousel} data-interval="7000">
  <div class="slides">{slides.map((slide, index) => <div class="slide" hidden={index !== 0} role="group" aria-roledescription={text.slide} aria-label={`${index + 1} ${text.of} 3`}>
    <div class="hero-media"><Photo class="hero-photo" src={`/images/photos/${slide.image}`} alt={slide.alt} loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} /><button class="image-edge previous" data-step="-1" aria-label={text.previousSlide}></button><button class="image-edge next" data-step="1" aria-label={text.nextSlide}></button></div>
    <div class="hero-copy"><h2>{slide.title}</h2>{slide.steps ? <ol>{slide.steps.map(step => <li>{step}</li>)}</ol> : <p>{slide.text}</p>}<a class="button" href={slide.href}>{slide.label}</a></div>
  </div>)}</div>
  <div class="carousel-controls"><button class="arrow" data-step="-1" aria-label={text.previousSlide}><svg viewBox="0 0 24 40" aria-hidden="true"><path d="M20 2 3 20l17 18" /></svg></button>{slides.map((slide, index) => <button class="dot" data-slide={index} aria-label={slide.title} aria-pressed={index === 0}><span aria-hidden="true"></span></button>)}<button class="arrow" data-step="1" aria-label={text.nextSlide}><svg viewBox="0 0 24 40" aria-hidden="true"><path d="m4 2 17 18L4 38" /></svg></button></div>
</section>

<style>
.hero{position:relative}.slide[hidden]{display:none}.slide:not([hidden]){display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);min-height:400px}
.hero-media{position:relative;min-width:0;overflow:hidden;touch-action:pan-y pinch-zoom;user-select:none}.hero-media :global(.photo){height:100%}.hero-media :global(.hero-photo){position:absolute;inset:0;width:100%;height:100%;object-fit:cover;pointer-events:none}
.hero-copy{background:var(--teal);padding:44px 8% 36px;color:#fff;display:flex;align-items:flex-start;flex-direction:column}.hero-copy h2{font-size:clamp(28px,2.6vw,44px);color:white;margin-bottom:24px}.hero-copy ol{padding-left:25px;margin:0 0 24px}.hero-copy li,.hero-copy p{line-height:1.65;font-size:clamp(16px,1.1vw,18px)}.hero-copy li+li{margin-top:8px}.hero-copy .button{align-self:flex-end;margin-top:auto}
.image-edge{position:absolute;top:0;bottom:0;width:24%;border:0;padding:0 20px;background:transparent;color:white;display:flex;align-items:center;font-size:48px;text-shadow:0 1px 6px #0009;touch-action:pan-y pinch-zoom}.previous{left:0;justify-content:flex-start}.next{right:0;justify-content:flex-end}.image-edge:focus-visible{outline:3px solid white;outline-offset:-6px}
.carousel-controls{position:absolute;z-index:2;left:25%;transform:translateX(-50%);bottom:20px;display:flex;align-items:center;gap:2px;padding:0 6px;background:transparent}.carousel-controls button{border:0;background:transparent;color:white;width:44px;height:44px;padding:0;display:grid;place-items:center}.dot span{width:14px;height:14px;border:2px solid white;border-radius:50%}.carousel-controls .dot[aria-pressed="true"] span{background:white}.arrow svg{width:22px;height:36px;fill:none;stroke:currentColor;stroke-width:2}.carousel-controls{filter:drop-shadow(0 1px 2px #0006);gap:6px}.dot span{width:18px;height:18px}
@media(max-width:1000px){.slide:not([hidden]){grid-template-columns:1fr;min-height:0}.hero-media{aspect-ratio:393/210;max-height:420px}.hero-copy{padding:28px 28px;min-height:260px}.hero-copy h2{font-size:28px;margin-bottom:18px}.hero-copy li,.hero-copy p{font-size:16px;line-height:1.6}.hero-copy ol{padding-left:24px;margin-bottom:20px}.carousel-controls{top:calc(min(100vw * 210 / 393,420px) - 56px);bottom:auto;left:50%}.image-edge{font-size:40px;padding:0 14px}}
</style>
<script>
import '../scripts/carousel';
</script>
