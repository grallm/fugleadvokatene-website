---
import {site} from '../data/site';
const slides=[{title:'Funnet en skadet fugl?',image:'e8f31.svg',alt:'Demoillustrasjon av en fugl',href:site.helpGroup,label:'Klikk her',steps:['Ta bilder eller video av fuglen','Ta kontakt på vår hjelpegruppe på Facebook','Si hvor den skadde fuglen befinner seg','Sikre fuglen, eller bli hos den til du får veiledning']},{title:'Støtt oss!',image:'7bcf9.svg',alt:'Demoillustrasjon av en due',href:'/stott-oss/',label:'Støtt oss',text:'Fugleadvokatene er en organisasjon drevet av frivillige, og vi er avhengige av donasjoner fra publikum for å kunne operere. Klikk videre for å se hvordan du kan støtte oss.'},{title:'Ønsker du å bli frivillig?',image:'2ae5f.svg',alt:'Demoillustrasjon av en frivillig med en due',href:'/bli-frivillig/',label:'Les mer',text:'Vi trenger stadig nye rehabiliteringshjem for skadede eller syke fugler. Her kan du lese hva som må til for å bli rehabiliteringshjem.'}];
---
<section class="hero" aria-label="Hjelp fuglene" aria-roledescription="karusell"><div class="slides">{slides.map((s,i)=><div class="slide" hidden={i!==0} role="group" aria-roledescription="lysbilde" aria-label={`${i+1} av 3`}><img class="hero-photo" src={`/images/demo/${s.image}`} alt={s.alt} fetchpriority={i===0?'high':'auto'}/><div class="hero-copy"><h2>{s.title}</h2>{s.steps?<ol>{s.steps.map(step=><li>{step}</li>)}</ol>:<p>{s.text}</p>}<a class="button" href={s.href}>{s.label}</a></div></div>)}</div><div class="carousel-controls"><button data-direction="-1" aria-label="Forrige lysbilde">‹</button>{slides.map((s,i)=><button class="dot" data-slide={i} aria-label={s.title} aria-pressed={i===0}></button>)}<button data-direction="1" aria-label="Neste lysbilde">›</button></div></section>
<style>.hero{position:relative}.slide:not([hidden]){display:grid;grid-template-columns:1fr 1fr;min-height:462px}.hero-photo{width:100%;height:100%;max-height:500px;object-fit:cover}.hero-copy{background:var(--teal);padding:64px 8.9% 40px;color:#fff;display:flex;align-items:flex-start;flex-direction:column}.hero-copy h2{font-size:clamp(32px,3.7vw,64px);color:white;margin-bottom:28px;white-space:nowrap}.hero-copy ol{padding-left:30px;margin:0 0 25px}.hero-copy li,.hero-copy p{line-height:2.08;font-size:clamp(16px,1.39vw,24px)}.hero-copy .button{align-self:flex-end;margin-top:auto}.carousel-controls{position:absolute;left:25%;transform:translateX(-50%);bottom:35px;display:flex;align-items:center;gap:12px}.carousel-controls button{border:0;background:none;color:white;font-size:48px;line-height:1;padding:0 5px;min-width:30px;min-height:44px}.carousel-controls .dot{min-width:0;min-height:0;width:20px;height:20px;border:2px solid white;border-radius:50%;padding:0}.dot[aria-pressed=true]{background:white}@media(max-width:1000px){.slide:not([hidden]){grid-template-columns:1fr}.hero-photo{height:auto;aspect-ratio:393/210;max-height:420px}.hero-copy{padding:34px 37px;min-height:260px}.hero-copy h2{font-size:32px;white-space:normal;margin-bottom:18px}.hero-copy li,.hero-copy p{font-size:16px;line-height:29px}.hero-copy ol{padding-left:24px;margin-bottom:15px}.carousel-controls{top:min(calc(100vw * .534 - 54px),366px);bottom:auto;left:50%;gap:8px}.carousel-controls .dot{width:13px;height:13px}.carousel-controls button{font-size:36px;min-width:24px}}</style>
<script>const hero=document.querySelector('.hero');const slides=Array.from(hero?.querySelectorAll<HTMLElement>('.slide')??[]);const dots=Array.from(hero?.querySelectorAll<HTMLButtonElement>('[data-slide]')??[]);let active=0;function show(i:number){active=(i+slides.length)%slides.length;slides.forEach((s,n)=>s.hidden=n!==active);dots.forEach((d,n)=>d.setAttribute('aria-pressed',String(n===active)));}dots.forEach((d,i)=>d.addEventListener('click',()=>show(i)));hero?.querySelectorAll<HTMLElement>('[data-direction]').forEach(b=>b.addEventListener('click',()=>show(active+Number(b.dataset.direction))));</script>
