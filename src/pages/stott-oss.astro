---
import Layout from '../layouts/Layout.astro';
import { t } from '../i18n/ui';
import { href, type Language } from '../i18n/routes';
interface Props { language?: Language }
const { language = 'nb' } = Astro.props;
const text = t(language);
import { site } from '../data/site';
---
<Layout title={text.support} language={language}>
  <div class="container page">
    <h1>{text.supportHeading}</h1><p class="lead">{text.supportLead}</p>
    <div class="grid donation-options">
      <section class="empty">
        <h2>Vipps</h2>
        <p>{text.vippsNumber}: <strong>{site.vipps}</strong></p>
        <div class="vipps-actions">
          <a class="button" href={site.vippsOneTime}>{language === 'en' ? 'Make a one-time donation with Vipps' : 'Gi en engangsgave via Vipps'}</a>
        <a class="button" href={site.monthly}>{text.monthly} {language === 'en' ? 'with' : 'via'} Vipps</a>
        </div>
        <p class="qr-label">{language === 'en' ? 'Or scan to donate with Vipps:' : 'Eller skann for å gi en gave via Vipps:'}</p>
        <a class="qr-link" href={site.vippsDonation} aria-label={language === 'en' ? 'Donate with Vipps' : 'Gi en gave via Vipps'}><img class="vipps-qr" src="/images/donations/vipps-donation.png" width="800" height="800" alt={language === 'en' ? 'Vipps QR code for Fugleadvokatene' : 'Vipps QR-kode for Fugleadvokatene'} /></a>
      </section>
      <section class="empty">
        <h2>PayPal</h2><p>{text.paypalText}</p>
        <a class="button" href={site.paypal}>{text.donate}</a>
        <h3 class="monthly-heading">{text.monthly} {language === 'en' ? 'with' : 'via'} PayPal</h3>
        <form action="https://www.paypal.com/donate" method="post" target="_top">
          <input type="hidden" name="hosted_button_id" value={site.paypalHostedButton} />
          <button class="button paypal-donate" type="submit">{text.monthly} {language === 'en' ? 'with' : 'via'} PayPal</button>
        </form>
      </section>
      <section class="empty"><h2>{text.bank}</h2><p>{text.account}<br /><strong>{site.bank}</strong></p><p>{text.grassroots}<br />{text.organisation} {site.organisation}</p></section>
    </div>
    <section class="monthly-agreement" aria-labelledby="monthly-agreement-heading">
      <h2 id="monthly-agreement-heading">{language === 'en' ? 'Recurring donations via Vipps' : 'Fastgiveravtale via Vipps'}</h2>
      <p class="monthly-terms">{language === 'en' ? 'There is no minimum commitment period for recurring donations. If you wish to cancel, you can email us at ' : 'Det er ingen bindingstid på fastgiveravtalen. Dersom du ønsker å avslutte avtalen kan du kontakte oss på epost '}<a href="mailto:kontakt@fugleadvokatene.no">kontakt@fugleadvokatene.no</a>{language === 'en' ? ' or cancel your agreement in the Vipps app.' : ' eller kansellere avtalen inne i Vipps-appen.'}</p>
    </section>
    <p class="section"><a href={href(language, 'volunteer')}>{text.timeInstead}</a></p>
  </div>
</Layout>
<style>
.vipps-actions{display:grid;gap:12px}.donation-options{align-items:start}.donation-options .button{width:100%;text-align:center;white-space:normal;padding:12px 16px}.monthly-agreement{max-width:850px;margin-top:40px}.monthly-agreement h2{font-size:22px;margin-bottom:12px}.monthly-terms{font-size:16px;margin:0}.monthly-terms a{overflow-wrap:anywhere}.qr-label{font-size:16px;margin:24px 0 12px}.qr-link{display:block;width:100%;max-width:240px;margin-inline:auto;border-radius:12px;overflow:hidden}.vipps-qr{width:100%;height:auto}.monthly-heading{font-size:22px;margin:32px 0 16px}.paypal-donate{background:#ffc439;color:#173b65}
@media(min-width:1001px) and (max-width:1200px){.donation-options{gap:20px}.donation-options .empty{padding:22px}}
</style>
