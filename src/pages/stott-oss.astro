---
import Layout from '../layouts/Layout.astro';
import { t } from '../i18n/ui';
import { href, type Language } from '../i18n/routes';
interface Props { language?: Language }
const { language = 'nb' } = Astro.props;
const text = t(language);
import { site } from '../data/site';
---
<Layout title={text.support} language={language}><div class="container page"><h1>{text.supportHeading}</h1><p class="lead">{text.supportLead}</p><div class="grid"><section class="empty"><h2>Vipps</h2><p>{text.vippsNumber}: <strong>{site.vipps}</strong></p><a class="button" href={site.monthly}>{text.monthly}</a></section><section class="empty"><h2>PayPal</h2><p>{text.paypalText}</p><a class="button" href={site.paypal}>{text.donate}</a></section><section class="empty"><h2>{text.bank}</h2><p>{text.account}<br /><strong>{site.bank}</strong></p><p>{text.grassroots}<br />{text.organisation} {site.organisation}</p></section></div><p class="section"><a href={href(language, 'volunteer')}>{text.timeInstead}</a></p></div></Layout>
