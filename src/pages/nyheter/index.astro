---
import Photo from '../../components/Photo.astro';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { isPreview } from '../../data/site';
import { t } from '../../i18n/ui';
import { locale, contentHref, type Language } from '../../i18n/routes';
interface Props { language?: Language }
const { language = 'nb' } = Astro.props;
const text = t(language);
const posts = (await getCollection(language === 'en' ? 'postsEn' : 'posts', ({ data }) => !data.draft || isPreview)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<Layout noindex={!posts.some(post => !post.data.draft)} title={text.news} language={language}><div class="container page"><h1>{text.news}</h1><h2 class="section">{text.newsHeading}</h2><div class="grid">{posts.map(post => <a class="card" href={contentHref(language, 'post', post.id)}><Photo src={post.data.image} alt="" loading="lazy" /><div class="card-body"><p>{post.data.date.toLocaleDateString(locale[language])}{post.data.draft && ` · ${text.draft}`}</p><h3>{post.data.title}</h3><p>{post.data.description}</p></div></a>)}</div>{!posts.length && <p>{text.noNews}</p>}</div></Layout>
