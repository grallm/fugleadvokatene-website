---
import Layout from '../layouts/Layout.astro';
import { t } from '../i18n/ui';
import type { Language } from '../i18n/routes';
interface Props { language?: Language }
const { language = 'nb' } = Astro.props;
const text = t(language);
import ContactLinks from '../components/ContactLinks.astro';
import { site } from '../data/site';
---
<Layout title={text.contact} language={language}><div class="container page"><h1>{text.contactHeading}</h1><div class="two-columns"><div><p class="lead">{text.contactLead}</p><ContactLinks language={language} /></div><aside><h2>{text.urgentHeading}</h2><p>{text.urgentText}</p><a class="button" href={site.helpGroup}>{text.helpGroup}</a></aside></div></div></Layout>
