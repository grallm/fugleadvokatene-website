---
import Layout from '../layouts/Layout.astro';
import { t } from '../i18n/ui';
import { href, type Language } from '../i18n/routes';
interface Props { language?: Language }
const { language = 'nb' } = Astro.props;
const text = t(language);
---
<Layout title={text.thanksTitle} noindex language={language}><div class="container page"><h1>{text.thanksHeading}</h1><p class="lead">{text.thanksText}</p><a class="button" href={href(language, 'home')}>{text.backHome}</a></div></Layout>
