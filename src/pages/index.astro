---
import Layout from "../layouts/Layout.astro";
import Placeholder from "../components/Placeholder.astro";

const navLinks = ["Contact", "Store", "Blog", "Guides", "Who we are"];

const welcomeCards = [
	{
		title: "Who can help near me?",
		body: "A list of available recovery homes",
	},
	{
		title: "Do you want to support us?",
		body: "This is how you can donate.",
	},
];

const guides = [
	{ title: "Is it injured?", body: "This is how you handle it" },
	{ title: "Handling of wild birds", body: "For their safety – and yours" },
	{
		title: "Always think about hygiene",
		body: "For both your sake and the birds",
	},
	{
		title: "What kind of bird is it?",
		body: "An overview of known city bird species",
	},
];

const blogPosts = [
	{
		title: "Known bird species in the city",
		caption: "Look here to know what bird you have found",
	},
	{
		title: "Laws and rules around helping birds",
		caption: "What you have to keep in mind",
	},
];

const products = [
	{ name: "Pin", price: "Price", description: "Product description" },
	{ name: "Kort", price: "Price", description: "Product description" },
	{ name: "Bærenett", price: "Price", description: "Product description" },
];
---

<Layout>
	<header class="site-header">
		<div class="container header-inner">
			<a href="/" class="brand">
				<Placeholder height="40px" width="40px" />
				<span class="brand-name">FugleAdvokatene</span>
			</a>
			<div class="hero-image">
				<Placeholder height="90px" width="240px" />
			</div>
		</div>
		<nav class="site-nav">
			<div class="container nav-inner">
				{navLinks.map((label) => <a href="#">{label}</a>)}
			</div>
		</nav>
	</header>

	<main>
		<section class="container welcome">
			<div class="welcome-text">
				<h2>Welcome to FugleAdvokatene.</h2>
				<p>
					We are a voluntary organisation who rescue and rehabilitate the
					citybirds of Oslo and Bergen.
				</p>
			</div>
			<div class="welcome-cards">
				{
					welcomeCards.map((card) => (
						<a class="card small" href="#">
							<h3>{card.title}</h3>
							<p>{card.body}</p>
						</a>
					))
				}
			</div>
		</section>

		<section class="container section">
			<h2>Did you find a bird?</h2>
			<p class="section-lead">
				Here are some smart guides to best help you take care of the situation
			</p>
			<div class="grid-2">
				{
					guides.map((g) => (
						<a class="card" href="#">
							<h3>{g.title}</h3>
							<p>{g.body}</p>
						</a>
					))
				}
			</div>
		</section>

		<section class="container section">
			<h2>Blog</h2>
			<div class="grid-2 blog-grid">
				{
					blogPosts.map((post) => (
						<article class="blog-post">
							<h3>{post.title}</h3>
							<Placeholder height="200px" />
							<p class="caption">{post.caption}</p>
						</article>
					))
				}
			</div>
		</section>

		<section class="container section">
			<h2 class="centered">Meet our regulars</h2>
			<div class="regulars">
				<div class="regulars-stack">
					<Placeholder height="180px" />
					<Placeholder height="180px" />
					<p class="caption">
						These birds don't need our help, but it is nice of you too keep an
						eye out.
					</p>
				</div>
				<div class="card nesting-card">
					<h3>Known nesting places and other volnurable areas</h3>
					<Placeholder height="180px" />
					<p class="caption">Please be a bit more aware around these areas</p>
				</div>
			</div>
		</section>

		<section class="container section">
			<h2 class="centered">Online store</h2>
			<h3 class="popular-title">Popular products</h3>
			<div class="grid-3">
				{
					products.map((product) => (
						<article class="product">
							<Placeholder height="180px" />
							<h4>{product.name}</h4>
							<p class="price">{product.price}</p>
							<p class="muted">{product.description}</p>
						</article>
					))
				}
			</div>
		</section>
	</main>

	<footer class="site-footer">
		<div class="container footer-inner">
			<div class="footer-contact">
				<p class="footer-name">FugleAdvokatene</p>
				<p>
					<span class="label">mail:</span> kontakt@fugleadvokatene.no
				</p>
				<p>
					<span class="label">tlf:</span> 99 99 99 99
				</p>
			</div>
			<div class="footer-social">
				<p class="social-label">Sosiale medier</p>
				<div class="social-icons" aria-label="Social media">
					<a href="#" aria-label="Facebook">
						<svg viewBox="0 0 24 24" width="22" height="22">
							<path
								fill="currentColor"
								d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.2c-1.2 0-1.6.8-1.6 1.6V12h2.7l-.4 2.9h-2.3v7A10 10 0 0 0 22 12z"
							></path>
						</svg>
					</a>
					<a href="#" aria-label="Instagram">
						<svg viewBox="0 0 24 24" width="22" height="22">
							<path
								fill="currentColor"
								d="M12 2.2c3.2 0 3.6 0 4.8.1 1.2 0 1.9.2 2.3.4.6.2 1 .5 1.5 1s.7.9 1 1.5c.2.4.3 1.1.4 2.3.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c0 1.2-.2 1.9-.4 2.3-.2.6-.5 1-1 1.5s-.9.7-1.5 1c-.4.2-1.1.3-2.3.4-1.3.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2 0-1.9-.2-2.3-.4-.6-.2-1-.5-1.5-1s-.7-.9-1-1.5c-.2-.4-.3-1.1-.4-2.3-.1-1.3-.1-1.6-.1-4.8s0-3.6.1-4.8c0-1.2.2-1.9.4-2.3.2-.6.5-1 1-1.5s.9-.7 1.5-1c.4-.2 1.1-.3 2.3-.4 1.3-.1 1.6-.1 4.8-.1zm0 2c-3.1 0-3.5 0-4.7.1-1.1 0-1.7.2-2 .4-.5.2-.9.4-1.3.8-.4.4-.6.8-.8 1.3-.2.3-.4.9-.4 2-.1 1.2-.1 1.6-.1 4.7s0 3.5.1 4.7c0 1.1.2 1.7.4 2 .2.5.4.9.8 1.3.4.4.8.6 1.3.8.3.2.9.4 2 .4 1.2.1 1.6.1 4.7.1s3.5 0 4.7-.1c1.1 0 1.7-.2 2-.4.5-.2.9-.4 1.3-.8.4-.4.6-.8.8-1.3.2-.3.4-.9.4-2 .1-1.2.1-1.6.1-4.7s0-3.5-.1-4.7c0-1.1-.2-1.7-.4-2-.2-.5-.4-.9-.8-1.3-.4-.4-.8-.6-1.3-.8-.3-.2-.9-.4-2-.4-1.2-.1-1.6-.1-4.7-.1zm0 3.4a4.4 4.4 0 1 1 0 8.8 4.4 4.4 0 0 1 0-8.8zm0 7.3a2.9 2.9 0 1 0 0-5.8 2.9 2.9 0 0 0 0 5.8zm5.6-7.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0z"
							></path>
						</svg>
					</a>
					<a href="#" aria-label="Twitter">
						<svg viewBox="0 0 24 24" width="22" height="22">
							<path
								fill="currentColor"
								d="M22 5.8c-.7.3-1.5.5-2.4.6.9-.5 1.5-1.4 1.8-2.4-.8.5-1.7.8-2.6 1A4.1 4.1 0 0 0 11.7 9c-3.4-.2-6.4-1.8-8.4-4.3-.4.6-.6 1.4-.6 2.2 0 1.4.7 2.7 1.8 3.4-.7 0-1.3-.2-1.9-.5 0 2 1.4 3.7 3.3 4.1-.4.1-.7.2-1.1.2-.3 0-.5 0-.8-.1.5 1.7 2.1 2.9 3.9 2.9A8.3 8.3 0 0 1 2 18.6 11.7 11.7 0 0 0 8.3 20c7.5 0 11.6-6.2 11.6-11.6v-.5c.8-.6 1.5-1.3 2.1-2.1z"
							></path>
						</svg>
					</a>
					<a href="#" aria-label="TikTok">
						<svg viewBox="0 0 24 24" width="22" height="22">
							<path
								fill="currentColor"
								d="M19.6 6.7a4.7 4.7 0 0 1-3-1.7 4.6 4.6 0 0 1-1-2.5h-3v12.4c0 1.4-1.2 2.6-2.6 2.6a2.6 2.6 0 1 1 .8-5.1V9.3a5.7 5.7 0 1 0 4.8 5.6V9.5a7.7 7.7 0 0 0 4 1.3V7.7c-.1 0-.7-.1-1-1z"
							></path>
						</svg>
					</a>
				</div>
			</div>
		</div>
	</footer>
</Layout>

<style>
	/* Header */
	.site-header {
		padding-top: 24px;
	}
	.header-inner {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 24px;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 12px;
	}
	.brand-name {
		font-size: 22px;
		font-weight: 700;
	}
	.hero-image {
		width: 240px;
	}
	.site-nav {
		border-bottom: 1px solid var(--border);
		margin-top: 18px;
	}
	.nav-inner {
		display: flex;
		justify-content: center;
		gap: 80px;
		padding: 14px 24px;
		flex-wrap: wrap;
	}
	.nav-inner a {
		font-size: 14px;
		color: var(--text);
	}

	/* Sections */
	main {
		padding-bottom: 60px;
	}
	.section {
		margin-top: 56px;
	}
	.section h2 {
		font-size: 18px;
		margin-bottom: 4px;
	}
	.section-lead {
		color: var(--text);
		font-size: 14px;
		margin-bottom: 20px;
	}
	.centered {
		text-align: center;
	}

	/* Welcome */
	.welcome {
		margin-top: 32px;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 32px;
		align-items: start;
	}
	.welcome-text h2 {
		font-size: 18px;
	}
	.welcome-text p {
		font-size: 14px;
	}
	.welcome-cards {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px;
	}

	/* Cards */
	.card {
		display: block;
		border: 1px solid var(--border);
		padding: 18px;
		color: inherit;
		background: #fff;
	}
	.card h3 {
		font-size: 14px;
		margin-bottom: 10px;
	}
	.card p {
		font-size: 12px;
		color: var(--muted);
	}
	.card.small {
		padding: 14px 16px;
	}
	.grid-2 {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 18px;
	}
	.grid-3 {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}

	/* Blog */
	.blog-grid {
		gap: 40px;
	}
	.blog-post h3 {
		font-size: 15px;
		margin-bottom: 14px;
	}
	.caption {
		font-size: 12px;
		color: var(--muted);
		margin-top: 10px;
	}

	/* Regulars */
	.regulars {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 40px;
		align-items: start;
	}
	.regulars-stack {
		display: grid;
		gap: 16px;
	}
	.nesting-card h3 {
		font-size: 15px;
		margin-bottom: 14px;
	}

	/* Store */
	.popular-title {
		font-size: 14px;
		margin: 18px 0 14px;
	}
	.product h4 {
		font-size: 13px;
		margin: 12px 0 4px;
	}
	.product .price {
		font-size: 13px;
		margin-bottom: 2px;
	}
	.product .muted {
		font-size: 13px;
		color: var(--text);
	}

	/* Footer */
	.site-footer {
		background: var(--footer-bg);
		padding: 28px 0;
	}
	.footer-inner {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 24px;
		align-items: center;
	}
	.footer-contact p {
		font-size: 13px;
		margin-bottom: 4px;
	}
	.footer-contact .label {
		display: inline-block;
		min-width: 36px;
		color: var(--muted);
	}
	.footer-name {
		font-weight: 700;
		margin-bottom: 8px !important;
	}
	.footer-social {
		text-align: center;
	}
	.social-label {
		font-size: 13px;
		margin-bottom: 12px;
	}
	.social-icons {
		display: flex;
		justify-content: center;
		gap: 18px;
		color: var(--text);
	}
	.social-icons a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}

	/* Responsive */
	@media (max-width: 760px) {
		.header-inner {
			flex-direction: column;
		}
		.hero-image {
			width: 100%;
		}
		.nav-inner {
			gap: 24px;
		}
		.welcome,
		.welcome-cards,
		.grid-2,
		.grid-3,
		.regulars,
		.footer-inner {
			grid-template-columns: 1fr;
		}
		.footer-social {
			text-align: left;
		}
		.social-icons {
			justify-content: flex-start;
		}
	}
</style>
