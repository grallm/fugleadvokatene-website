---
import Layout from '../layouts/Layout.astro';
import { t } from '../i18n/ui';
import { href, type Language } from '../i18n/routes';
interface Props { language?: Language }
const { language = 'nb' } = Astro.props;
const text = t(language);
import Hero from '../components/Hero.astro';
import SocialFeed from '../components/SocialFeed.astro';
import { getCollection } from 'astro:content';
import { isPreview } from '../data/site';
import { contentHref } from '../i18n/routes';
const volunteers = (await getCollection(language === 'en' ? 'volunteersEn' : 'volunteers', ({ data }) => !data.draft || isPreview)).sort((a, b) => a.data.order - b.data.order);
---
<Layout title={text.homeTitle} language={language}>
  <Hero language={language} />
  <div class="container">
    <section class="welcome section">
      <h1>{text.welcome}</h1>
      <div class="welcome-columns">
        <div><p>{text.intro}</p><p class="desktop-intro">{text.introMore}</p></div>
        <div class="ctas">
          <a href={`${href(language, 'help')}#${language === 'en' ? 'help-near-you' : 'hjelp-naer-deg'}`}><img src="/images/demo/329c2.svg" alt="" /><div><h3>{text.helpNearby}</h3><p>{text.helpNearbyCta}</p></div></a>
          <a href={href(language, 'support')}><img src="/images/demo/56f49.svg" alt="" /><div><h3>{text.supportQuestion}</h3><p>{text.supportCta}</p></div></a>
        </div>
      </div>
    </section>
    <section class="section">
      <h2>{text.meetVolunteers}</h2>
      <div class="grid volunteers">{volunteers.slice(0, 3).map(person => <a class="card" href={contentHref(language, 'volunteer', person.id)}><img src={person.data.image} alt={person.data.title} loading="lazy" /><div class="card-body"><h3>{person.data.title}</h3><p>{person.data.description}</p></div></a>)}</div>
      {!volunteers.length && <p><a href={href(language, 'volunteer')}>{text.joinTeam}</a></p>}
    </section>
    <section class="section latest"><h2>{text.news}</h2><SocialFeed language={language} /><p class="blog-link"><a href={href(language, 'news')}>{text.allNews}</a></p></section>
  </div>
</Layout>
<style>.welcome h1{margin-bottom:100px}.welcome-columns{display:grid;grid-template-columns:1.28fr 1fr;gap:8.5%}.ctas{display:grid;gap:50px;align-content:start}.ctas>a{display:flex;align-items:center;gap:28px;min-height:177px;padding:24px;border-radius:20px;background:var(--coral);color:#fff;text-decoration:none}.ctas img{width:24%;height:auto;object-fit:contain}.ctas h3{color:#fff;font-size:clamp(18px,1.85vw,32px);margin-bottom:18px}.ctas p{margin:0;white-space:nowrap}.volunteers .card p{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.latest{padding-bottom:100px}.blog-link{margin-top:36px}@media(max-width:1000px){.welcome h1{margin-bottom:25px}.welcome-columns{grid-template-columns:1fr;gap:30px}.desktop-intro{display:none}.ctas{gap:18px}.ctas>a{min-height:109px;padding:15px;gap:18px;border-radius:10px}.ctas img{width:67px}.ctas h3{margin-bottom:18px}.ctas p{font-size:12px;white-space:normal}.volunteers{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:10px;margin-right:-37px}.volunteers .card{flex:0 0 235px;scroll-snap-align:start;border-radius:10px}.volunteers .card>img{height:179px}.volunteers .card-body{padding:18px 30px 28px}.volunteers .card h3{font-size:32px;margin-bottom:18px}.volunteers .card p{font-size:12px;line-height:14px;-webkit-line-clamp:4}.latest{padding-bottom:0}}</style>
