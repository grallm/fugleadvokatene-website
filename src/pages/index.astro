---
import Layout from '../layouts/Layout.astro';import Hero from '../components/Hero.astro';import SocialFeed from '../components/SocialFeed.astro';import {getCollection} from 'astro:content';import {isPreview} from '../data/site';
const volunteers=(await getCollection('volunteers',({data})=>!data.draft||isPreview)).sort((a,b)=>a.data.order-b.data.order);
---
<Layout title="Hvert fugleliv er verdt å redde"><Hero/>
<div class="container"><section class="welcome section"><h1>Velkommen til Fugleadvokatene</h1><div class="welcome-columns"><div><p>FugleAdvokatene er en frivillig forening som driver med redning og rehabilitering av byfugler. En av våre hjertesaker er å endre den utbredte praksisen hvor skadede og syke byfugler avlives uten gyldig medisinsk grunn.</p><p class="desktop-intro">FugleAdvokatene er en ideell organisasjon drevet av frivillige ildsjeler som rehabiliterer fugler ved siden av en vanlig fulltidsjobb. Vi har derfor ikke mulighet til å være tilgjengelige på telefon, e-post e.l., men svarer så fort vi kan i «FugleAdvokatenes hjelpegruppe» på Facebook. Har dere en fugl som trenger hjelp, legg ut en post der – gjerne med et bilde og annen relevant informasjon – og vent på vårt svar.</p></div><div class="ctas"><a href="/veiledning/#hjelp-naer-deg"><img src="/images/demo/329c2.svg" alt=""/><div><h3>Hvem kan hjelpe nær meg?</h3><p>Finn veiledning og hjelp</p></div></a><a href="/stott-oss/"><img src="/images/demo/56f49.svg" alt=""/><div><h3>Ønsker du å støtte oss?</h3><p>Her er hvordan du kan hjelpe</p></div></a></div></div></section>
<section class="section"><h2>Møt våre frivillige</h2><div class="grid volunteers">{volunteers.slice(0,3).map(v=><a class="card" href={`/frivillige/${v.id}/`}><img src={v.data.image} alt={v.data.title} loading="lazy"/><div class="card-body"><h3>{v.data.title}</h3><p>{v.data.description}</p></div></a>)}</div>{!volunteers.length&&<p><a href="/bli-frivillig/">Vil du bli en del av laget?</a></p>}</section>
<section class="section latest"><h2>Siste nytt</h2><SocialFeed/><p class="blog-link"><a href="/nyheter/">Se alle nyheter →</a></p></section></div></Layout>
<style>.welcome h1{margin-bottom:100px}.welcome-columns{display:grid;grid-template-columns:1.28fr 1fr;gap:8.5%}.ctas{display:grid;gap:50px;align-content:start}.ctas>a{display:flex;align-items:center;gap:28px;min-height:177px;padding:24px;border-radius:20px;background:var(--coral);color:#fff;text-decoration:none}.ctas img{width:24%;height:auto;object-fit:contain}.ctas h3{color:#fff;font-size:clamp(18px,1.85vw,32px);margin-bottom:18px}.ctas p{margin:0;white-space:nowrap}.volunteers .card p{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.latest{padding-bottom:100px}.blog-link{margin-top:36px}@media(max-width:1000px){.welcome h1{margin-bottom:25px}.welcome-columns{grid-template-columns:1fr;gap:30px}.desktop-intro{display:none}.ctas{gap:18px}.ctas>a{min-height:109px;padding:15px;gap:18px;border-radius:10px}.ctas img{width:67px}.ctas h3{margin-bottom:18px}.ctas p{font-size:12px;white-space:normal}.volunteers{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:10px;margin-right:-37px}.volunteers .card{flex:0 0 235px;scroll-snap-align:start;border-radius:10px}.volunteers .card>img{height:179px}.volunteers .card-body{padding:18px 30px 28px}.volunteers .card h3{font-size:32px;margin-bottom:18px}.volunteers .card p{font-size:12px;line-height:14px;-webkit-line-clamp:4}.latest{padding-bottom:0}}</style>
