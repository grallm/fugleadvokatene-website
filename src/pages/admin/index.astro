---
import '@fontsource-variable/gabarito';import '@toast-ui/editor/dist/toastui-editor.css';
---
<!doctype html><html lang="nb"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'"/><title>Administrasjon · FugleAdvokatene</title></head><body>
<header><a href="/">FugleAdvokatene</a><strong>Innhold</strong><button id="logout" hidden>Logg ut</button></header>
<main><p id="status" role="status" aria-live="polite">Kobler til …</p>
<form id="login" hidden><h1>Logg inn</h1><label>Brukernavn<input name="username" autocomplete="username" required/></label><label>Passord<input type="password" name="password" autocomplete="current-password" required/></label><button>Logg inn</button></form>
<div id="workspace" hidden><aside><label>Innholdstype<select id="collection"><option value="posts">Nyheter</option><option value="pages">Sider</option><option value="volunteers">Frivillige</option><option value="products">Produkter</option></select></label><button id="new" type="button">+ Nytt innhold</button><ul id="entries"></ul><p>Alle endringer lagres i GitHub. Nettsiden oppdateres etter et vellykket bygg.</p></aside>
<form id="content"><h1 id="editor-title">Nytt innhold</h1><input type="hidden" name="sha"/>
<div class="fields"><label>Tittel<input name="title" required maxlength="150"/></label><label>Adresse / slug<input name="slug" required pattern="[a-z0-9]+(-[a-z0-9]+)*" maxlength="80" placeholder="en-ny-historie"/></label></div>
<label>Kort beskrivelse<textarea name="description" required maxlength="400" rows="3"></textarea></label>
<div class="fields"><label>Bilde<input name="image" required value="/images/demo/eb9b4.svg"/></label><label>Last opp bilde<input id="upload" type="file" accept="image/png,image/jpeg,image/webp"/></label></div><p class="help">JPEG, PNG eller WebP, inntil 4 MB. Bildet publiseres gjennom GitHub.</p>
<label data-only="posts">Dato<input type="date" name="date"/></label>
<div class="fields" data-only="volunteers"><label>Sted<input name="city"/></label><label>Rolle<input name="role" value="Frivillig"/></label><label>Rekkefølge<input name="order" type="number" min="0" value="0"/></label></div>
<div data-only="products"><div class="fields"><label>Pris i NOK<input name="price" type="number" min="0" step="0.01" value="0"/></label><label>Betalingslenke (HTTPS)<input name="checkoutUrl" type="url"/></label></div><label class="check"><input type="checkbox" name="available"/>Tilgjengelig for kjøp</label><p class="help">Opprett produktet og betalingslenken hos betalingsleverandøren først. Pris og lager må også vedlikeholdes der.</p></div>
<label class="check"><input type="checkbox" name="draft" checked/>Utkast – skjult på produksjonssiden</label><p class="help">For å avpublisere: merk som utkast og lagre.</p>
<label for="editor">Innhold</label><div id="editor"></div><div class="actions"><button id="save" type="submit">Lagre i GitHub</button><span id="saved"></span></div></form></div></main>
<script>
import Editor from '@toast-ui/editor';
const $=<T extends HTMLElement>(s:string)=>document.querySelector<T>(s)!;
const status=$<HTMLElement>('#status'),login=$<HTMLFormElement>('#login'),workspace=$<HTMLElement>('#workspace'),form=$<HTMLFormElement>('#content'),collection=$<HTMLSelectElement>('#collection');
const editor=new Editor({el:$('#editor'),height:'480px',initialEditType:'markdown',previewStyle:'tab',usageStatistics:false,hideModeSwitch:true,autofocus:false});
let csrf='',dirty=false,busy=false;let previousCollection=collection.value;
const field=(name:string)=>form.elements.namedItem(name) as HTMLInputElement;
function message(text:string){status.textContent=text;}
function authState(authenticated:boolean){login.hidden=authenticated;workspace.hidden=!authenticated;$('#logout').hidden=!authenticated;}
async function request(action:string,payload?:Record<string,unknown>|FormData){const multipart=payload instanceof FormData;const response=await fetch(`/api/index.php?action=${action}`,{credentials:'same-origin',method:payload?'POST':'GET',headers:payload?{'X-CSRF-Token':csrf,...(!multipart?{'Content-Type':'application/json'}:{})}:{},body:payload?(multipart?payload:JSON.stringify(payload)):undefined});const data=await response.json();if(!response.ok){if(response.status===401)authState(false);throw Error(data.error||'Forespørselen feilet.');}return data;}
function newContent(){form.reset();field('sha').value='';field('slug').readOnly=false;field('date').value=new Date().toISOString().slice(0,10);editor.setMarkdown('');$('#editor-title').textContent='Nytt innhold';$('#saved').textContent='';document.querySelectorAll<HTMLElement>('[data-only]').forEach(el=>el.hidden=el.dataset.only!==collection.value);dirty=false;}
async function list(){const data=await request(`list&collection=${encodeURIComponent(collection.value)}`);const entries=$('#entries');entries.replaceChildren();for(const entry of data.entries){const li=document.createElement('li');const button=document.createElement('button');button.type='button';button.textContent=entry.slug;button.addEventListener('click',async()=>{if(busy||dirty&&!confirm('Forkaste ulagrede endringer?'))return;try{const data=await request(`read&collection=${collection.value}&slug=${encodeURIComponent(entry.slug)}`);newContent();for(const [key,value] of Object.entries(data)){const input=form.elements.namedItem(key) as HTMLInputElement|null;if(!input)continue;if(input.type==='checkbox')input.checked=value===true;else input.value=String(value??'');}field('slug').readOnly=true;editor.setMarkdown(data.body||'');$('#editor-title').textContent=data.title;dirty=false;message('Innhold lastet.');}catch(e){message((e as Error).message);}});li.append(button);entries.append(li);}}
form.addEventListener('input',()=>dirty=true);editor.on('change',()=>dirty=true);window.addEventListener('beforeunload',e=>{if(dirty){e.preventDefault();}});
$('#new').addEventListener('click',()=>{if(!busy&&(!dirty||confirm('Forkaste ulagrede endringer?')))newContent();});
collection.addEventListener('change',async()=>{if(busy||dirty&&!confirm('Forkaste ulagrede endringer?')){collection.value=previousCollection;return;}previousCollection=collection.value;newContent();try{await list();}catch(e){message((e as Error).message);}});
login.addEventListener('submit',async e=>{e.preventDefault();try{const data=await request('login',Object.fromEntries(new FormData(login)));csrf=data.csrf;authState(true);login.reset();newContent();await list();message('Du er logget inn.');}catch(e){message((e as Error).message);}});
$('#logout').addEventListener('click',async()=>{if(busy||dirty&&!confirm('Logge ut og forkaste ulagrede endringer?'))return;try{await request('logout',{});dirty=false;location.reload();}catch(e){message((e as Error).message);}});
form.addEventListener('submit',async e=>{e.preventDefault();if(busy)return;busy=true;form.inert=true;const save=$<HTMLButtonElement>('#save');save.disabled=true;message('Lagrer i GitHub …');const payload={...Object.fromEntries(new FormData(form)),collection:collection.value,body:editor.getMarkdown(),draft:field('draft').checked,available:field('available').checked};try{const data=await request('save',payload);field('sha').value=data.sha;field('slug').readOnly=true;dirty=false;$('#saved').textContent=`Commit ${data.commit.slice(0,7)}`;message(data.message);await list();}catch(e){message((e as Error).message);}finally{busy=false;form.inert=false;save.disabled=false;}});
$('#upload').addEventListener('change',async e=>{const input=e.target as HTMLInputElement;const file=input.files?.[0];if(!file||busy)return;const payload=new FormData();payload.append('image',file);busy=true;try{message('Laster opp …');const data=await request('upload',payload);field('image').value=data.path;dirty=true;message(data.message);}catch(e){message((e as Error).message);}finally{busy=false;input.value='';}});
request('session').then(async data=>{csrf=data.csrf;authState(data.authenticated);if(data.authenticated){newContent();await list();}message(data.authenticated?'Klar.':'Logg inn for å redigere.');}).catch(e=>message(e.message));
</script>
<style is:global>:root{font-family:'Gabarito Variable',sans-serif;color:#044240;background:#edf3f1}*{box-sizing:border-box}body{margin:0}header{display:flex;align-items:center;gap:30px;padding:24px 5%;background:#cce2e1}header button{margin-left:auto}main{max-width:1350px;margin:auto;padding:20px 30px}button,input,textarea,select{font:inherit}button{cursor:pointer;background:#044240;color:white;padding:12px 22px;border:0;border-radius:5px}button:disabled{opacity:.5}a{color:inherit}label{display:grid;gap:8px;margin:14px 0;font-weight:600}input,textarea,select{padding:12px;border:1px solid #8aa8a0;border-radius:5px;width:100%;color:#152d27;background:#fff}.fields{display:grid;grid-template-columns:1fr 1fr;gap:20px}.check{display:flex;align-items:center}.check input{width:20px;height:20px}#workspace:not([hidden]){display:grid;grid-template-columns:230px 1fr;gap:40px}aside p,.help{font-size:14px;color:#526c66}#entries{list-style:none;padding:0}#entries button{width:100%;text-align:left;margin-bottom:5px;background:transparent;color:#044240;border:1px solid #abc2bb}#content{min-width:0}#login{max-width:420px;margin:50px auto}#status{padding:16px;background:#d9e9e3;border-radius:6px;min-height:52px}.actions{display:flex;gap:20px;align-items:center;margin-block:20px}.toastui-editor-defaultUI{background:white}#editor label{display:initial}#editor button{padding:0;background:initial;color:initial}#editor input{width:auto}[hidden]{display:none!important}:focus-visible{outline:3px solid #c34c3f;outline-offset:4px}@media(max-width:800px){#workspace:not([hidden]){grid-template-columns:1fr}.fields{grid-template-columns:1fr}main{padding-inline:18px}}</style>
</body></html>
