---
import Layout from '../layouts/Layout.astro';
import { t } from '../i18n/ui';
import { href, type Language } from '../i18n/routes';
interface Props { language?: Language }
const { language = 'nb' } = Astro.props;
const text = t(language);
import { getCollection } from 'astro:content';
import { locale } from '../i18n/routes';
const products = await getCollection(language === 'en' ? 'productsEn' : 'products', ({ data }) => !data.draft);
---
<Layout title={text.shop} language={language}><div class="container page"><h1>{text.shop}</h1><p class="lead">{text.shopLead}</p><div class="grid">{products.map(product => <article class="empty"><img src={product.data.image} alt={product.data.title} /><h2 style="font-size:32px;margin-top:24px">{product.data.title}</h2><p>{product.data.description}</p><p class="price">{new Intl.NumberFormat(locale[language], { style: 'currency', currency: 'NOK' }).format(product.data.price)}</p>{product.data.available && product.data.checkoutUrl ? <a class="button" href={product.data.checkoutUrl} rel="noopener">{text.buy}</a> : <p>{text.unavailable}</p>}</article>)}</div>{!products.length && <div class="empty"><h2>{text.shopSoon}</h2><p>{text.meanwhile} <a href={href(language, 'support')}>{text.supportHere}</a>.</p></div>}<p style="margin-top:32px">{text.paymentInfo} <a href={href(language, 'terms')}>{text.readTerms}</a>.</p></div></Layout>
