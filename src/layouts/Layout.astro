---
import Icon from '../components/Icon.astro';
import '@fontsource-variable/gabarito';
import '@fontsource/lato/700.css';
import '../styles/global.css';
import { site, isPreview } from '../data/site';
import { t } from '../i18n/ui';
import { href, type Language } from '../i18n/routes';
import { languageLinks } from '../i18n/content';
interface Props { title: string; description?: string; image?: string; noindex?: boolean; language?: Language }
const { title, image = '/images/photos/baby-bird.webp', noindex = false, language = 'nb' } = Astro.props;
const text = t(language);
const description = Astro.props.description ?? text.defaultDescription;
const canonical = new URL(['/404', '/404/', '/404.html'].includes(Astro.url.pathname) ? '/404.html' : Astro.url.pathname, Astro.site);
const alternates = await languageLinks(Astro.url.pathname);
const navigation = ['contact', 'volunteer', 'shop', 'news', 'help'] as const;
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline src="/scripts/site-language.js"></script>
    <title>{title} · {site.name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {Object.entries(alternates).map(([lang, path]) => <link rel="alternate" hreflang={lang} href={new URL(path!, Astro.site)} />)}
    {alternates.nb && <link rel="alternate" hreflang="x-default" href={new URL(alternates.nb, Astro.site)} />}
    <meta property="og:title" content={`${title} · ${site.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={language === 'en' ? 'en_GB' : 'nb_NO'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    {(isPreview || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
  </head>
  <body>
    <a class="skip" href="#main">{text.skip}</a>
    <header class="header">
      <a href={href(language, 'home')} aria-label={text.homeLabel} class="brand">
        <img class="brand-logo" src="/images/brand/logo-horizontal.webp" width="960" height="279" alt="Fugleadvokatene" />
      </a>
      <button class="menu-toggle" aria-controls="navigation" aria-expanded="false" aria-label={text.openMenu} data-open-label={text.openMenu} data-close-label={text.closeMenu}><span></span><span></span><span></span></button>
      <nav id="navigation" aria-label={text.mainNav}>
        {navigation.map(key => <a href={href(language, key)} aria-current={Astro.url.pathname === href(language, key) ? 'page' : undefined}>{text[key]}</a>)}
        <details class="about-dropdown">
          <summary>{text.about}<svg aria-hidden="true" viewBox="0 0 12 8" width="12" height="8"><path d="m1 1 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5" /></svg></summary>
          <div class="about-links">
            <a href={href(language, 'about')} aria-current={Astro.url.pathname === href(language, 'about') ? 'page' : undefined}>{language === 'en' ? 'About Fugleadvokatene' : 'Om Fugleadvokatene'}</a>
            <a href={href(language, 'volunteers')} aria-current={Astro.url.pathname === href(language, 'volunteers') ? 'page' : undefined}>{text.meetVolunteers}</a>
          </div>
        </details>
        <a class="button" href={href(language, 'support')}>{text.support}</a>
        <div class="language-switcher" role="group" aria-label={text.languageNav}>
          <a href={alternates.nb ?? href('nb', 'home')} lang="nb" hreflang="nb" data-site-language="nb" aria-current={language === 'nb' ? 'true' : undefined}>Norsk</a>
          <span aria-hidden="true">/</span>
          <a href={alternates.en ?? href('en', 'home')} lang="en" hreflang="en" data-site-language="en" aria-current={language === 'en' ? 'true' : undefined}>English</a>
        </div>
      </nav>
    </header>
    <a class="calendar-banner" href="https://kalendar.fugleadvokatene.no/"><span>{language === 'en' ? "Buy our 2027 calendar featuring hand-painted portraits of birds we’ve rescued" : 'Kjøp kalenderen vår for 2027 med håndmalte portretter av fugler vi har reddet'}</span><strong>{language === 'en' ? 'See the calendar →' : 'Se kalenderen →'}</strong></a>
    <main id="main"><slot /></main>
    <footer class="footer">
      <div class="container">
        <div class="footer-top"><a class="footer-brand" href={href(language, 'home')}><img src="/images/brand/logo-horizontal-white.png" width="2000" height="696" alt="Fugleadvokatene" loading="lazy" /></a><a class="button" href={href(language, 'support')}>{text.support}</a></div>
        <div class="footer-columns">
          <nav aria-label={text.footerNav}>
            {(['about', 'volunteer', 'shop', 'help', 'contact'] as const).map(key => <a href={href(language, key)}>{key === 'help' ? text.faq : text[key]}</a>)}
          </nav>
          <div><strong>{text.email}</strong><a href={`mailto:${site.email}`}>{site.email}</a><strong>{text.organisation}</strong><span>{site.organisation}</span></div>
        </div>
        <div class="social-links"><a href={site.facebook} aria-label="Facebook"><Icon name="facebook" /></a><a href={site.instagram} aria-label="Instagram"><Icon name="instagram" /></a></div>
        <div class="footer-bottom"><a href={href(language, 'privacy')}>{text.privacy}</a><p>© {new Date().getFullYear()} FugleAdvokatene. {text.copyright}</p><p class="credits">Designed by <a href="https://aggieampersand.com/">Agnetha</a> and developed by <a href="https://www.linkedin.com/in/malo-grall/">Malo</a></p></div>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector('#navigation');
      const about = document.querySelector<HTMLDetailsElement>('.about-dropdown');
      function closeMenu() {
        if (about) about.open = false;
        toggle?.setAttribute('aria-expanded', 'false');
        toggle?.setAttribute('aria-label', toggle.dataset.openLabel ?? '');
        nav?.classList.remove('open');
      }
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', (open ? toggle.dataset.closeLabel : toggle.dataset.openLabel) ?? '');
        nav?.classList.toggle('open', open);
      });
      document.addEventListener('keydown', event => {
        if (event.key !== 'Escape') return;
        if (about?.open) {
          about.open = false;
          about.querySelector('summary')?.focus();
        } else {
          const wasOpen = toggle?.getAttribute('aria-expanded') === 'true';
          closeMenu();
          if (wasOpen) toggle?.focus();
        }
      });
      document.addEventListener('click', event => {
        if (about?.open && event.target instanceof Node && !about.contains(event.target)) about.open = false;
      });
      about?.addEventListener('focusout', event => {
        if (event.relatedTarget instanceof Node && !about.contains(event.relatedTarget)) about.open = false;
      });
    </script>
  </body>
</html>
