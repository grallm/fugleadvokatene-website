# Install in /public_html/.htaccess, NOT /public_html/prod/.htaccess.
# Enable the canonical redirect only after SSL covers both production hostnames.
RewriteEngine On

# Keep certificate validation reachable on every hostname.
RewriteRule ^\.well-known/ - [L]

# Canonical hostname and HTTPS; never redirect the other subdomains.
RewriteCond %{HTTP_HOST} ^(www\.)?fugleadvokatene\.no$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.fugleadvokatene\.no$ [NC]
RewriteRule ^ https://www.fugleadvokatene.no%{REQUEST_URI} [R=301,L]

# Normalize directory URLs before internally adding /prod.
RewriteCond %{HTTP_HOST} ^(www\.)?fugleadvokatene\.no$ [NC]
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{DOCUMENT_ROOT}/prod%{REQUEST_URI} -d
RewriteRule ^(.*)$ /$1/ [R=301,L]

# L permits /prod/.htaccess to process the legacy URL redirects.
# The exclusion prevents repeated rewriting.
RewriteCond %{HTTP_HOST} ^(www\.)?fugleadvokatene\.no$ [NC]
RewriteCond %{REQUEST_URI} !^/prod(?:/|$)
RewriteRule ^(.*)$ /prod/$1 [L]

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php74” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php74 .php .php7 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
