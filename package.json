{
  "name": "fugleadvokatene",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "check": "astro check",
    "build": "astro build && node scripts/package.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "test:php": "php backend/tests/run.php",
    "test:http": "node backend/tests/http.mjs",
    "serve:php": "php -S 127.0.0.1:8080 -t build/public scripts/router.php",
    "deploy": "node scripts/deploy.mjs",
    "format:php": "prettier --write \"{backend,public/api,scripts}/**/*.php\"",
    "format:php:check": "prettier --check \"{backend,public/api,scripts}/**/*.php\"",
    "test:site": "node --test tests/site/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@fontsource-variable/gabarito": "^5.2.8",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@toast-ui/editor": "^3.2.2",
    "astro": "7.3.5",
    "rehype-sanitize": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@prettier/plugin-php": "0.25.0",
    "basic-ftp": "^5.0.5",
    "prettier": "3.9.9",
    "typescript": "^5.9.3"
  }
}
